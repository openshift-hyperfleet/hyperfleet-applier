{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "config": {
      "additionalProperties": false,
      "description": "Applier configuration",
      "properties": {
        "discoveryRefreshInterval": {
          "default": "30s",
          "description": "Interval between Kubernetes discovery cache refreshes",
          "title": "discoveryRefreshInterval",
          "type": "string"
        },
        "kubeConfigPath": {
          "default": "",
          "title": "kubeConfigPath",
          "type": "string"
        },
        "log": {
          "additionalProperties": false,
          "description": "Logging configuration",
          "properties": {
            "format": {
              "default": "json",
              "description": "Log format (\"json\" or \"text\")",
              "title": "format",
              "type": "string"
            },
            "level": {
              "default": "info",
              "description": "Log level (e.g., \"info\", \"debug\", \"warn\", \"error\")",
              "title": "level",
              "type": "string"
            },
            "output": {
              "default": "stdout",
              "description": "Log output destination (\"stdout\" or \"stderr\")",
              "title": "output",
              "type": "string"
            }
          },
          "required": [],
          "title": "log",
          "type": "object"
        },
        "managementCluster": {
          "default": "",
          "description": "Management cluster identifier - must match the partition this applier instance manages (required)",
          "title": "managementCluster",
          "type": "string"
        },
        "pollInterval": {
          "default": "1m",
          "description": "Polling interval for reconciliation loops (e.g., \"5s\", \"1m\")",
          "title": "pollInterval",
          "type": "string"
        },
        "redis": {
          "additionalProperties": false,
          "properties": {
            "url": {
              "default": "",
              "description": "Redis connection URL",
              "title": "url",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "title": "redis",
          "type": "object"
        }
      },
      "required": [
        "managementCluster",
        "pollInterval",
        "discoveryRefreshInterval",
        "redis"
      ],
      "title": "config",
      "type": "object"
    },
    "configOverride": {
      "default": "",
      "description": "Raw config.yaml content that replaces the template-generated config.yaml\nconfigOverride must have the required values management_cluster, poll_interval,\ndiscovery_refresh_interval, and clients.redis.url\nwhen set, default values in config are ignored\nExample: --set-file configOverride=configs/applier.yaml",
      "title": "configOverride",
      "type": "string"
    },
    "fullnameOverride": {
      "default": "",
      "description": "Override the full release name",
      "title": "fullnameOverride",
      "type": "string"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "title": "global",
      "type": "object"
    },
    "image": {
      "additionalProperties": false,
      "description": "Container image configuration",
      "properties": {
        "pullPolicy": {
          "default": "IfNotPresent",
          "description": "Image pull policy",
          "title": "pullPolicy",
          "type": "string"
        },
        "registry": {
          "default": "",
          "description": "Container image registry (required)",
          "title": "registry",
          "type": "string"
        },
        "repository": {
          "default": "",
          "description": "Container image repository (required)",
          "title": "repository",
          "type": "string"
        },
        "tag": {
          "default": "",
          "description": "Container image tag (required)",
          "title": "tag",
          "type": "string"
        }
      },
      "required": [
        "registry",
        "repository",
        "tag"
      ],
      "title": "image",
      "type": "object"
    },
    "imagePullSecrets": {
      "description": "List of image pull secrets to use for pulling container images",
      "items": {
        "required": []
      },
      "title": "imagePullSecrets",
      "type": "array"
    },
    "nameOverride": {
      "default": "",
      "description": "Override the chart name",
      "title": "nameOverride",
      "type": "string"
    },
    "podAnnotations": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Annotations to add to controller pods",
      "required": [],
      "title": "podAnnotations",
      "type": "object"
    },
    "podLabels": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Labels to add to controller pods",
      "required": [],
      "title": "podLabels",
      "type": "object"
    },
    "podSecurityContext": {
      "additionalProperties": false,
      "description": "Pod-level security context",
      "properties": {
        "runAsNonRoot": {
          "default": true,
          "title": "runAsNonRoot",
          "type": "boolean"
        },
        "seccompProfile": {
          "additionalProperties": false,
          "properties": {
            "type": {
              "default": "RuntimeDefault",
              "title": "type",
              "type": "string"
            }
          },
          "required": [],
          "title": "seccompProfile",
          "type": "object"
        }
      },
      "required": [
        "runAsNonRoot",
        "seccompProfile"
      ],
      "title": "podSecurityContext",
      "type": "object"
    },
    "rbac": {
      "additionalProperties": false,
      "description": "RBAC configuration for the controller",
      "properties": {
        "allowlist": {
          "description": "Explicit allowlist of API group + resource pairs the applier's ServiceAccount may manage\non this cluster. Each entry must specify `apiGroups` and `resources`; verbs (get, list, watch,\ncreate, patch, delete) are added automatically by the template. Do NOT add a \"*\"\napiGroup or resource here -- see rbac.devModeWildcard for the (off-by-default) escape hatch.\nThis list must be tailored per Helm release/management cluster; see \"Deriving the RBAC\nallowlist\" in the chart README for how to compute it.",
          "items": {
            "required": []
          },
          "title": "allowlist",
          "type": "array"
        },
        "create": {
          "default": true,
          "description": "Create RBAC resources (ClusterRole, ClusterRoleBinding)",
          "title": "create",
          "type": "boolean"
        },
        "devModeWildcard": {
          "default": false,
          "description": "Example: if an adapter produces ConfigMaps on this cluster:\nallowlist:\n  - apiGroups: [\"\"]\n    resources: [\"configmaps\"]\nDANGER: replaces rbac.allowlist with a cluster-wide \"*\"/\"*\" ClusterRole rule when\ntrue. This disables the allowlist entirely and grants unrestricted access to every\nresource type in the cluster. NEVER enable this in a shared, staging, or production\ncluster; add the required resource types to rbac.allowlist instead.\nDefault: false (must be explicitly opted into).",
          "title": "devModeWildcard",
          "type": "boolean"
        }
      },
      "required": [
        "create",
        "allowlist",
        "devModeWildcard"
      ],
      "title": "rbac",
      "type": "object"
    },
    "replicaCount": {
      "default": 1,
      "description": "Number of controller replicas to run",
      "title": "replicaCount",
      "type": "integer"
    },
    "resources": {
      "additionalProperties": false,
      "description": "Resource requests and limits for the controller container",
      "properties": {
        "limits": {
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "default": "500m",
              "title": "cpu",
              "type": "string"
            },
            "memory": {
              "default": "512Mi",
              "title": "memory",
              "type": "string"
            }
          },
          "required": [
            "cpu",
            "memory"
          ],
          "title": "limits",
          "type": "object"
        },
        "requests": {
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "default": "100m",
              "title": "cpu",
              "type": "string"
            },
            "memory": {
              "default": "128Mi",
              "title": "memory",
              "type": "string"
            }
          },
          "required": [
            "cpu",
            "memory"
          ],
          "title": "requests",
          "type": "object"
        }
      },
      "required": [
        "limits",
        "requests"
      ],
      "title": "resources",
      "type": "object"
    },
    "securityContext": {
      "additionalProperties": false,
      "description": "Container-level security context",
      "properties": {
        "allowPrivilegeEscalation": {
          "default": false,
          "title": "allowPrivilegeEscalation",
          "type": "boolean"
        },
        "capabilities": {
          "additionalProperties": false,
          "properties": {
            "drop": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  }
                ],
                "required": []
              },
              "title": "drop",
              "type": "array"
            }
          },
          "required": [],
          "title": "capabilities",
          "type": "object"
        },
        "readOnlyRootFilesystem": {
          "default": true,
          "title": "readOnlyRootFilesystem",
          "type": "boolean"
        },
        "runAsNonRoot": {
          "default": true,
          "title": "runAsNonRoot",
          "type": "boolean"
        }
      },
      "required": [],
      "title": "securityContext",
      "type": "object"
    },
    "serviceAccount": {
      "additionalProperties": false,
      "description": "Service account configuration - controller needs API access",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Annotations to add to the service account",
          "required": [],
          "title": "annotations",
          "type": "object"
        },
        "create": {
          "default": true,
          "description": "Create a service account for the controller",
          "title": "create",
          "type": "boolean"
        },
        "name": {
          "default": "",
          "description": "Override the service account name",
          "title": "name",
          "type": "string"
        }
      },
      "required": [],
      "title": "serviceAccount",
      "type": "object"
    }
  },
  "required": [
    "imagePullSecrets",
    "nameOverride",
    "serviceAccount",
    "rbac",
    "podAnnotations",
    "podLabels",
    "podSecurityContext",
    "securityContext",
    "resources",
    "replicaCount",
    "image",
    "config"
  ],
  "type": "object"
}